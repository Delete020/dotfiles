font-family = Hack Nerd Font
font-size = 14
background = 191724
foreground = EDF0F5
selection-background = FCFAF2
selection-foreground = 1E1E2E
cursor-color = C0C5CE
cursor-text = 212121
palette = 0=#303030
palette = 1=#CB4042
palette = 2=#3DDA92
palette = 3=#F9A55B
palette = 4=#2EA9DF
palette = 5=#986DB2
palette = 6=#51A8DD
palette = 7=#EDF0F5
palette = 8=#7F8C8D
palette = 9=#D75455
palette = 10=#00AA90
palette = 11=#FC9F4D
palette = 12=#7DB9DE
palette = 13=#884CC3
palette = 14=#4785EB
palette = 15=#FBFCFC
background-opacity = 0.85
window-decoration = none
window-show-tab-bar = never
window-padding-x = 6
window-padding-y = 6
window-padding-balance = true
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
shell-integration = detect
shell-integration-features = sudo,ssh-env,ssh-terminfo
copy-on-select = clipboard
